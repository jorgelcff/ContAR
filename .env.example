# Frontend build-time Avaturn settings used by Docker Compose.
VITE_AVATURN_DIRECT_URL=
VITE_AVATURN_SUBDOMAIN=
VITE_AVATURN_DISABLE_BACKEND_FALLBACK=false
VITE_AVATURN_USER_ID=

# Leave unset for a single-domain deploy (frontend + backend behind the same
# nginx/Caddy, e.g. docker-compose.prod.yml) — the frontend then calls
# same-origin /api. Only set this if the backend lives on a different origin.
VITE_API_BASE_URL=

# Production domain (docker-compose.prod.yml / Caddyfile) — e.g. meudominio.com.
# DNS must already point this domain's A record at the VPS before starting
# Caddy, or it can't provision a Let's Encrypt certificate.
DOMAIN=