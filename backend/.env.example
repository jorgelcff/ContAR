PORT=3001
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/avaturn3d

# OBRIGATÓRIO em produção — use uma string longa e aleatória
AUTH_JWT_SECRET=change_me_in_production

# Deploy atrás de um único domínio (Hostinger + Caddy/nginx, docker-compose.prod.yml):
# estes três devem ser o MESMO domínio público (com https://) — o navegador
# ainda envia Origin em requests same-origin, então CORS_ORIGIN precisa bater
# exatamente; BACKEND_URL evita que o link de arquivos locais (fallback sem
# Cloudinary) saia com o hostname interno do container em vez do domínio real.
FRONTEND_URL=https://seudominio.com
CORS_ORIGIN=https://seudominio.com
BACKEND_URL=https://seudominio.com

# Email — reset de senha e verificação (SMTP via nodemailer; RESEND_API_KEY
# só funciona aqui como flag liga/desliga do envio, não é usado para chamar a API da Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ContAR <noreply@seudominio.com>

# OpenAI — mapeamento automático de ossos com IA (opcional — sem a chave o fallback usa só regex)
OPENAI_API_KEY=sk-...

# TTS com ElevenLabs (opcional — sem a chave o botão retorna 503)
ELEVENLABS_API_KEY=

# TTS com Azure Speech (opcional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Avaturn SDK (opcional)
AVATURN_API_TOKEN=
AVATURN_API_BASE_URL=https://api.avaturn.me/api/v1
AVATURN_USER_ID=

# Cloudinary — recomendado em produção para uploads de avatar/áudio (CDN,
# não cresce o disco da VPS). Sem essas três chaves, cai no fallback de disco
# local — funciona numa VPS (diferente do Render, cujo disco é efêmero) desde
# que o volume uploads_data do docker-compose esteja montado, e BACKEND_URL
# esteja configurado acima.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Custo do bcrypt (padrão 10 se não definido — não precisa mexer em produção;
# só existe para o backend de E2E rodar mais barato durante os testes)
BCRYPT_COST=10

# Limite de tentativas de login/registro por IP a cada 15 min
AUTH_RATE_LIMIT_MAX=100

# Proxy (Render, Railway, Hostinger atrás de Caddy/nginx, etc.)
TRUST_PROXY=1
