# Loaded by `npm run dev` only — `vite build` runs in production mode and
# ignores this file, and the Docker build sets its variables explicitly.
#
# The local .env points VITE_API_BASE_URL at the production backend on Render,
# so the dev server used to read and write real data: a test story created
# while developing landed in production, and a local test could not find a
# story seeded into the local database. This makes the local backend
# (docker compose up, port 3001) the default for development.
#
# To point the dev server at production on purpose, put the line below in
# .env.development.local (git-ignored), which takes precedence:
#   VITE_API_BASE_URL=https://avaturn-threejs.onrender.com
VITE_API_BASE_URL=http://localhost:3001
