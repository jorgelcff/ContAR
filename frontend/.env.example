# Direct Web SDK mode (no backend session creation):
# Use ONE of the options below.

# Option A: full URL
VITE_AVATURN_DIRECT_URL=https://jlcf.avaturn.dev

# Option B: subdomain only
VITE_AVATURN_SUBDOMAIN=jlcf

# Optional: fixed user id used by frontend to list avatars in direct mode
# VITE_AVATURN_USER_ID=

# Optional debug flag: when true, prevents fallback to backend /api/avatar/session
# VITE_AVATURN_DISABLE_BACKEND_FALLBACK=true

# Optional: serve the app from a subpath instead of the domain root — e.g. a
# personal directory on a shared server (/~username/). Leave unset for a
# normal root deploy (this is what production needs).
# VITE_BASE_PATH=/~jlcf

# Optional: point the frontend at a backend running somewhere other than the
# same origin (e.g. testing a subpath frontend deploy against the production
# API). This is the backend's ORIGIN only — /api is appended automatically,
# do not include it here. Leave unset to use same-origin /api (the normal
# case when frontend and backend share a domain, e.g. behind one nginx).
# VITE_API_BASE_URL=https://avaturn-threejs.onrender.com
